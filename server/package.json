{
  "name": "server",
  "version": "1.0.0",
  "description": "Virtual Classroom Backend Server",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "dev": "NODE_ENV=development nodemon server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "tsc",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:dev": "NODE_ENV=development npx prisma migrate dev",
    "prisma:migrate:prod": "npx prisma migrate deploy --env-file .env.production",
    "prisma:push:test": "NODE_ENV=test npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "ts-node --esm prisma/seed.ts --env-file .env.development"
  },
  "author": "Sayan Chandra",
  "license": "ISC",
  "dependencies": {
    "@arcjet/node": "^1.0.0-beta.17",
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.6",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
