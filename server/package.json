{
  "name": "server",
  "version": "1.0.0",
  "description": "Virtual Classroom Backend Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
    "test:coverage": "npm test -- --coverage",
    "dev": "NODE_ENV=development nodemon src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "tsc",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:dev": "NODE_ENV=development npx prisma migrate dev",
    "prisma:migrate:prod": "npx prisma migrate deploy --env-file .env.production",
    "prisma:push:test": "NODE_ENV=test npx prisma db push --env-file .env.test",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "ts-node --esm prisma/seed.ts --env-file .env.development"
  },
  "author": "Sayan Chandra",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "minio": "^8.0.6",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.9",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
